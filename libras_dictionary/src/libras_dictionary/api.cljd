(ns libras-dictionary.api
  (:require [libras-dictionary.models :as m]
            ["package:http/http.dart" :as http]
            ["package:flutter/foundation.dart" :refer [kDebugMode]]
            ["package:path_provider/path_provider.dart" :as pp]
            ["dart:convert" :as json]
            ["dart:io" :as io]
            ["package:diacritic/diacritic.dart" :refer [removeDiacritics]]))

(defn log [& args]
  (when kDebugMode
    (apply println args)))

(def ^Duration request-timeout (Duration. .seconds 10))

(defn normalize [s]
  (-> s removeDiacritics .toLowerCase))

(defn word-bound-regex [query]
  (RegExp. (str "\\b" (RegExp/escape (normalize query)) "\\b") .unicode true))

(defn fetch-url
  "GET `url-str` with a request timeout. Returns the response body.
  Throws on timeout or non-200 status."
  [url-str & {:keys [headers]}]
  (let [url (Uri/parse url-str)
        future (if headers
                 (http/get url .headers headers)
                 (http/get url))
        response (await (.timeout future request-timeout))]
    (when (not= (.-statusCode response) 200)
      (throw (Exception. (str "HTTP " (.-statusCode response) " em " url-str))))
    (.-body response)))

;; --- INES ---

(defonce ines-cache (atom nil))

(defn parse-ines-body [^String body]
  (let [start (.indexOf body "[")
        end (.lastIndexOf body "]")]
    (when (and (not= start -1) (not= end -1))
      (json/json.decode (.substring body start (inc end))))))

(defn- ines-cache-file []
  (let [dir (await (pp/getApplicationSupportDirectory))]
    (io/File. (str (.-path dir) "/ines_palavras.json"))))

(defn- save-ines-to-disk! [^String body]
  (try
    (let [f (await (ines-cache-file))]
      (await (.writeAsString ^io/File f body)))
    (catch Object e
      (log "INES: could not persist cache:" e))))

(defn- load-ines-from-disk []
  (try
    (let [f ^io/File (await (ines-cache-file))]
      (when (await (.exists f))
        (parse-ines-body (await (.readAsString f)))))
    (catch Object e
      (log "INES: could not read disk cache:" e)
      nil)))

(defn load-ines-data
  "INES word list: memory cache, else network (persisting to disk),
  else disk cache (offline). Throws when all fail."
  []
  (if-let [cached @ines-cache]
    cached
    (try
      (let [body (await (fetch-url "https://dicionario.ines.gov.br/public/site/js/palavras.js"))
            data (parse-ines-body body)]
        (when (nil? data)
          (throw (Exception. "INES: resposta em formato inesperado")))
        (reset! ines-cache data)
        (save-ines-to-disk! body)
        data)
      (catch Object e
        (log "INES network fetch failed, trying disk cache:" e)
        (if-let [disk (await (load-ines-from-disk))]
          (do (reset! ines-cache disk) disk)
          (throw e))))))

(defn ines-words
  "All INES headwords currently cached (for autocomplete). Empty when
  the list was never loaded."
  []
  (if-let [data @ines-cache]
    (into [] (keep #(get % "palavra")) data)
    []))

(defn fetch-ines [query]
  (let [data (await (load-ines-data))
        ^RegExp regex (word-bound-regex query)]
    (into []
          (comp
           (filter (fn [item]
                     (let [palavra (get item "palavra" "")]
                       (.hasMatch regex (normalize palavra)))))
           (map (fn [item]
                  (let [palavra ^String (get item "palavra")
                        video ^String (get item "video")
                        image ^String (get item "image")]
                    (m/make-dict-item
                     :title (or palavra "Sem título")
                     :description (get item "descricao")
                     :exemplo (get item "exemplo")
                     :libras (get item "libras")
                     :video-url (when (and video (not (.-isEmpty video)))
                                  (str "https://dicionario.ines.gov.br/public/media/palavras/videos/" video))
                     :image-url (when (and image (not (.-isEmpty image)))
                                  (str "https://dicionario.ines.gov.br/public/media/palavras/images/" image))
                     :link (str "https://dicionario.ines.gov.br/pt/search?word=" (Uri/encodeComponent (or palavra "")))
                     :source "INES")))))
          data)))

;; --- Video / YouTube extraction ---

(defn extract-video-and-youtube-id [content]
  (let [video-exp (RegExp. "<video[^>]+src\\s*=\\s*[\"']([^\"']+)[\"']")
        yt-embed-exp (RegExp. "src\\s*=\\s*[\"']https:\\/\\/www\\.youtube\\.com\\/embed\\/([^\"'?]+)")
        yt-watch-exp (RegExp. "https:\\/\\/www\\.youtube\\.com\\/watch\\?v=([^\"&\\s]+)")
        yt-short-exp (RegExp. "https:\\/\\/youtu\\.be\\/([^\"&\\s<]+)")
        pb-video-exp (RegExp. "src\\s*=\\s*[\"'](http[^\"']+?\\.mp4)[\"']")
        pb-yt-exp (RegExp. "src\\s*=\\s*[\"'](https:\\/\\/www\\.youtube\\.com\\/watch\\?v=[^\"&]+)[\"']")]
    (if-let [video-match (.firstMatch video-exp content)]
      {:video-url (.group ^RegExpMatch video-match 1) :youtube-id nil}
      (if-let [yt-match (.firstMatch yt-embed-exp content)]
        {:video-url nil :youtube-id (.group ^RegExpMatch yt-match 1)}
        (if-let [yt-watch-match (.firstMatch yt-watch-exp content)]
          {:video-url nil :youtube-id (.group ^RegExpMatch yt-watch-match 1)}
          (if-let [yt-short-match (.firstMatch yt-short-exp content)]
            {:video-url nil :youtube-id (.group ^RegExpMatch yt-short-match 1)}
            (if-let [pb-video-match (.firstMatch pb-video-exp content)]
              {:video-url (.group ^RegExpMatch pb-video-match 1) :youtube-id nil}
              (if-let [pb-yt-match (.firstMatch pb-yt-exp content)]
                {:video-url nil :youtube-id (some->> (.group ^RegExpMatch pb-yt-match 1)
                                                     (.firstMatch (RegExp. "watch\\?v=([^\"&\\s]+)"))
                                                     (fn [m] (.group ^RegExpMatch m 1)))}
                {:video-url nil :youtube-id nil}))))))))

(defn youtube-search-url
  "URL for an external YouTube search for signs of `query` in Libras.
  Opened via url_launcher; in-app YouTube search was removed for
  YouTube ToS compliance."
  [query]
  (str "https://www.youtube.com/results?search_query="
       (Uri/encodeQueryComponent (str query " em libras"))))

;; --- WordPress-based sources (RedeSurdos, LibrasAcademicaUFF) ---

(defn- fetch-wordpress
  "Searches a WordPress REST API and maps matching posts through
  `item->dict`. Throws on network/HTTP failure."
  [search-url query item->dict]
  ;; per_page=100: the default of 10 hides exact-title posts that rank
  ;; below content-only matches in WP's full-text relevance order.
  (let [body (await (fetch-url (str search-url (Uri/encodeQueryComponent query) "&per_page=100")))
        data (json/json.decode body)
        ^RegExp regex (word-bound-regex query)]
    (into []
          (comp
           (filter (fn [item]
                     (let [title (get-in item ["title" "rendered"] "")]
                       (.hasMatch regex (normalize title)))))
           (map item->dict))
          data)))

(defn fetch-rede-surdos [query]
  (fetch-wordpress
   "https://redesurdosce.ufc.br/wp-json/wp/v2/posts?search="
   query
   (fn [item]
     (let [content (get-in item ["content" "rendered"] "")
           extraction (extract-video-and-youtube-id content)]
       (m/make-dict-item
        :title (get-in item ["title" "rendered"])
        :description (let [excerpt ^String (get-in item ["excerpt" "rendered"] "")]
                       (if (.-isEmpty excerpt) content excerpt))
        :video-url (:video-url extraction)
        :youtube-id (:youtube-id extraction)
        :link (get item "link")
        :source "RedeSurdos")))))

(defn fetch-libras-academica-uff [query]
  (fetch-wordpress
   "https://librasacademica.uff.br/wp-json/wp/v2/posts?search="
   query
   (fn [item]
     (let [content (get-in item ["content" "rendered"] "")
           extraction (extract-video-and-youtube-id content)]
       (m/make-dict-item
        :title (get-in item ["title" "rendered"])
        :description (get-in item ["excerpt" "rendered"])
        :video-url (:video-url extraction)
        :youtube-id (:youtube-id extraction)
        :link (get item "link")
        :source "LibrasAcademicaUFF")))))

;; --- UFV ---

(defn fetch-ufv-detail
  "Detail page fetch; returns nil on failure so one broken page does
  not sink the whole result set."
  [url-str title]
  (try
    (let [body (await (fetch-url url-str))
          video-exp (RegExp. "<video[^>]+src\\s*=\\s*[\"']([^\"']+)[\"']")
          video-match (.firstMatch video-exp body)]
      (when video-match
        (let [video-url (some-> (.group ^RegExpMatch video-match 1) ^String (.trim))]
          (when (not (.-isEmpty video-url))
            (m/make-dict-item
             :title title
             :video-url video-url
             :link url-str
             :source "UFV")))))
    (catch Object e
      (log "Error fetching UFV detail:" e)
      nil)))

(defn fetch-ufv [query]
  (let [body (await (fetch-url (str "https://sistemas.cead.ufv.br/capes/dicionario/?s=" (Uri/encodeQueryComponent query))))
        ^RegExp regex (word-bound-regex query)
        item-exp (RegExp. "<a href=\"([^\"]+)\">(?:\\s*)<h4>([^<]+)</h4>")
        matches (.allMatches item-exp body)
        detail-futures (atom [])]
    (doseq [^RegExpMatch match matches]
      (let [link (.group match 1)
            title (some-> (.group match 2) ^String (.trim))]
        (when (and link title (.hasMatch regex (normalize title)))
          (swap! detail-futures conj (fetch-ufv-detail link title)))))
    (let [details (await (Future/wait @detail-futures))]
      (into [] (filter some?) details))))

;; --- SpreadTheSign ---

(def ^:private sts-headers {"User-Agent" "Mozilla/5.0"})

(defn fetch-spread-the-sign-detail
  "Detail page fetch; returns nil on failure (partial results OK)."
  [url-str title]
  (try
    (let [body (await (fetch-url url-str :headers sts-headers))
          video-exp (RegExp. "<video[^>]*src\\s*=\\s*[\"'](https:\\/\\/media\\.spreadthesign\\.com\\/video\\/mp4\\/[^\"']+)[\"']")
          video-match (.firstMatch video-exp body)]
      (when video-match
        (m/make-dict-item
         :title title
         :video-url (.group ^RegExpMatch video-match 1)
         :link url-str
         :source "SpreadTheSign")))
    (catch Object e
      (log "Error fetching SpreadTheSign detail:" e)
      nil)))

(defn fetch-spread-the-sign [query]
  (let [url-str (str "https://www.spreadthesign.com/pt.br/search/?q=" (Uri/encodeQueryComponent query))
        body (await (fetch-url url-str :headers sts-headers))
        ^RegExp regex (word-bound-regex query)
        video-exp (RegExp. "<video[^>]*src\\s*=\\s*[\"'](https:\\/\\/media\\.spreadthesign\\.com\\/video\\/mp4\\/[^\"']+)[\"']")
        video-match (.firstMatch video-exp body)
        results (atom [])]
    (when video-match
      (let [video-url (.group ^RegExpMatch video-match 1)
            title-exp (RegExp. "<span class=\"flag-icon flag-icon-br bordered\"><\\/span>\\s*([^<\n]+)")
            title-match (.firstMatch title-exp body)]
        (when title-match
          (let [title (^String .trim (.group ^RegExpMatch title-match 1))]
            (when (.hasMatch regex (normalize title))
              (swap! results conj
                     (m/make-dict-item
                      :title title
                      :video-url video-url
                      :link url-str
                      :source "SpreadTheSign")))))))
    (let [result-exp (RegExp. "<div class=\"search-result-title\">\\s*<a href=\"(\\/pt\\.br\\/word\\/[^\"]+)\"[^>]*>\\s*([^<\n]+)")
          matches (.allMatches result-exp body)
          detail-futures (atom [])]
      (doseq [^RegExpMatch match matches]
        (let [link (.group match 1)
              title (some-> (.group match 2) ^String (.trim))]
          (when (and link title (.hasMatch regex (normalize title)))
            (swap! detail-futures conj (fetch-spread-the-sign-detail (str "https://www.spreadthesign.com" link) title)))))
      (let [details (await (Future/wait @detail-futures))]
        (doseq [item (filter some? details)]
          (when-not (some (fn [r] (= (:video-url r) (:video-url item))) @results)
            (swap! results conj item)))
        @results))))

;; --- Orchestration ---

(def source-fetchers
  {"INES" fetch-ines
   "RedeSurdos" fetch-rede-surdos
   "UFV" fetch-ufv
   "LibrasAcademicaUFF" fetch-libras-academica-uff
   "SpreadTheSign" fetch-spread-the-sign})

(defn- run-fetcher [source-name fetcher query]
  (try
    (let [items (await (fetcher query))]
      (log "search:" source-name "->" (count items) "items")
      {:items items})
    (catch Object e
      (log "!!! search failed for" source-name ":" e)
      {:failed source-name})))

(defn search-all
  "Runs all enabled fetchers in parallel. Returns
  {:items [...] :failed [source-names]} — a failed source never sinks
  the others' results."
  [query & {:keys [sources]}]
  (let [wanted (or sources (keys source-fetchers))
        futures (into []
                      (keep (fn [source-name]
                              (when-let [fetcher (get source-fetchers source-name)]
                                (run-fetcher source-name fetcher query))))
                      wanted)
        results (await (Future/wait futures))]
    {:items (into [] (mapcat :items) results)
     :failed (into [] (keep :failed) results)}))
