(ns libras-dictionary.strings
  "User-facing text, centralised for future i18n. pt-BR only for now.")

(def app-title "Dicionário Libras")
(def search-label "Pesquisar (Português)")
(def search-button "Buscar")
(def youtube-button "YouTube")
(def youtube-tooltip "Buscar no YouTube")
(def search-youtube "Buscar no YouTube")
(def not-found-dictionaries "Não encontrado nos dicionários.")
(def type-to-search "Digite uma palavra acima para pesquisar")
(defn no-results-for [query] (str "Nenhum resultado encontrado para \"" query "\""))
(def try-again "Tentar novamente")
(def search-error "Não foi possível completar a busca. Verifique sua conexão e tente novamente.")
(defn sources-unavailable [names] (str "Fontes indisponíveis: " names))
(def recent-searches "Buscas recentes")
(def favorites-title "Favoritos")
(def favorites-empty "Nenhum favorito ainda. Toque na estrela de um sinal para salvá-lo.")
(def favorite-add "Adicionar aos favoritos")
(def favorite-remove "Remover dos favoritos")
(def video-error "Erro ao carregar o vídeo.")
(def youtube-error "Não foi possível reproduzir o vídeo.")
(def open-in-youtube "Abrir no YouTube")
(def play-video "Reproduzir vídeo")
(def share-sign "Compartilhar sinal")
(def expand-hint "Toque para expandir")
(def collapse-hint "Toque para recolher")
(def description-label "Descrição:")
(def example-label "Exemplo:")
(def glosa-label "Tradução Libras (Glosa):")
(def settings-title "Configurações")
(def settings-search-section "Configurações de Busca")
(def settings-share-minimal "Texto de compartilhamento mínimo")
(def settings-share-minimal-sub "Envia apenas a palavra e o link ao compartilhar")
(def settings-sources "Fontes de Pesquisa")
(def settings-sources-sub "Ative ou desative as fontes de palavras")
(def settings-credits "Direitos Reservados")
(def settings-credits-sub "Créditos e fontes de dados")
(def settings-license "Licença do Projeto")
(def settings-license-text "Este projeto é de domínio público (CC0).")
(def settings-github "Repositório no GitHub")
(def settings-website "Site do projeto")
(def filter-all "Todos")
(defn share-text-minimal [title link] (str title ": " link))
(defn share-text-full [title link] (str "Veja este sinal de Libras para \"" title "\": " link))
(defn share-subject [title] (str "Sinal de Libras: " title))
