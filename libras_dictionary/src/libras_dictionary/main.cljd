(ns libras-dictionary.main
  (:require [cljd.flutter :as f]
            [clojure.string :as str]
            [libras-dictionary.card :as card]
            [libras-dictionary.settings-screen :as settings]
            [libras-dictionary.state :as st]
            [libras-dictionary.strings :as s]
            ["package:flutter/material.dart" :as mat]
            ["package:flutter_svg/flutter_svg.dart" :as svg]))

(defn favorites-screen []
  (f/widget
   :watch [state st/app-state]
   (let [favorites (:favorites state)]
     (mat/Scaffold.
      .appBar (mat/AppBar. .title (mat/Text. s/favorites-title))
      .body (if (empty? favorites)
              (mat/Center.
               .child (mat/Padding.
                       .padding (mat/EdgeInsets.all 32.0)
                       .child (mat/Column.
                               .mainAxisAlignment mat.MainAxisAlignment/center
                               .children
                               [(mat/Icon. mat.Icons/star_border
                                           .size 64
                                           .color (.-shade400 mat.Colors/grey))
                                (mat/SizedBox. .height 16)
                                (mat/Text. s/favorites-empty
                                           .style (mat/TextStyle.
                                                   .fontSize 16
                                                   .color (.-shade600 mat.Colors/grey))
                                           .textAlign mat.TextAlign/center)])))
              (mat/ListView.builder
               .itemCount (count favorites)
               .itemBuilder (fn [ctx idx]
                              (card/dictionary-item-card (get favorites idx)))))))))

(defn- failed-sources-banner [failed-sources]
  (mat/Container.
   .width double/infinity
   .color (.withOpacity (.-shade700 mat.Colors/amber) 0.15)
   .padding (mat/EdgeInsets.symmetric .horizontal 16.0 .vertical 8.0)
   .child (mat/Row.
           .children
           [(mat/Icon. mat.Icons/warning_amber
                       .size 18
                       .color (.-shade800 mat.Colors/amber))
            (mat/SizedBox. .width 8)
            (mat/Expanded.
             .child (mat/Text.
                     (s/sources-unavailable (str/join ", " failed-sources))
                     .style (mat/TextStyle.
                             .fontSize 13
                             .color (.-shade900 mat.Colors/amber))))])))

(defn- suggestion-list [suggestions search-controller]
  (mat/Padding.
   .padding (mat/EdgeInsets.symmetric .horizontal 16.0)
   .child (mat/Wrap.
           .spacing 8.0
           .runSpacing 4.0
           .children
           (map (fn [^String word]
                  (mat/ActionChip.
                   .label (mat/Text. word .style (mat/TextStyle. .fontSize 13))
                   .onPressed (fn []
                                (set! (.-text ^mat/TextEditingController search-controller) word)
                                (swap! st/app-state assoc :search-query word)
                                (st/perform-search! word)
                                nil)))
                suggestions))))

(defn- recent-searches-block [recents search-controller]
  (mat/Column.
   .mainAxisSize mat.MainAxisSize/min
   .children
   [(mat/Padding.
     .padding (mat/EdgeInsets.only .top 24.0 .bottom 8.0)
     .child (mat/Text. s/recent-searches
                       .style (mat/TextStyle.
                               .fontSize 14
                               .fontWeight mat.FontWeight/w600
                               .color (.-shade600 mat.Colors/grey))))
    (mat/Wrap.
     .spacing 8.0
     .runSpacing 4.0
     .alignment mat.WrapAlignment/center
     .children
     (map (fn [^String q]
            (mat/ActionChip.
             .avatar (mat/Icon. mat.Icons/history .size 16)
             .label (mat/Text. q .style (mat/TextStyle. .fontSize 13))
             .onPressed (fn []
                          (set! (.-text ^mat/TextEditingController search-controller) q)
                          (swap! st/app-state assoc :search-query q)
                          (st/perform-search! q)
                          nil)))
          recents))]))

(defn- filter-chips [active-filters enabled-sources is-dark?]
  (mat/Padding.
   .padding (mat/EdgeInsets.symmetric .horizontal 16.0 .vertical 8.0)
   .child
   (mat/Wrap.
    .spacing 8.0
    .runSpacing 8.0
    .alignment mat.WrapAlignment/center
    .children
    (into
     [(let [is-selected? (contains? active-filters "Ambos")]
        (mat/FilterChip.
         .label (mat/Text. s/filter-all
                           .style (mat/TextStyle.
                                   .fontSize 13
                                   .fontWeight mat.FontWeight/bold
                                   .color (if is-selected? mat.Colors/white (if is-dark? mat.Colors/white (mat/Color. 0xFF1C1B1F)))))
         .selected is-selected?
         .onSelected (fn [val]
                       (st/on-filter-changed! "Ambos" val)
                       nil)
         .showCheckmark false
         .selectedColor (.-shade600 mat.Colors/blue)
         .backgroundColor (.withOpacity (.-shade600 mat.Colors/grey) 0.2)
         .shape (mat/RoundedRectangleBorder. .borderRadius (mat/BorderRadius.circular 8))
         .elevation 1
         .pressElevation 2
         .padding (mat/EdgeInsets.symmetric .horizontal 8.0 .vertical 6.0)))]
     (map
      (fn [source]
        (let [is-selected? (contains? active-filters source)
              display-label (case source
                              "RedeSurdos" "Rede Surdos"
                              "LibrasAcademicaUFF" "Libras Acadêmica"
                              source)]
          (mat/FilterChip.
           .label (mat/Text. display-label
                              .style (mat/TextStyle.
                                      .fontSize 13
                                      .color (if is-selected? mat.Colors/white (if is-dark? mat.Colors/white (mat/Color. 0xFF1C1B1F)))))
           .selected is-selected?
           .onSelected (fn [val]
                         (st/on-filter-changed! source val)
                         nil)
           .showCheckmark false
           .selectedColor (card/get-source-color source)
           .backgroundColor (.withOpacity (.-shade600 mat.Colors/grey) 0.2)
           .shape (mat/RoundedRectangleBorder. .borderRadius (mat/BorderRadius.circular 8))
           .elevation 1
           .pressElevation 2
           .padding (mat/EdgeInsets.symmetric .horizontal 8.0 .vertical 6.0))))
      (sort (seq enabled-sources)))))))

(defn home-page []
  (f/widget
   :context ctx
   :managed [search-controller
             (mat/TextEditingController.)
             :dispose ((fn [c] (.dispose ^mat/TextEditingController c)))]
   :watch [state st/app-state]
   (let [{:keys [theme-mode is-loading search-results search-query last-searched
                 active-filters enabled-sources error-message failed-sources
                 recent-searches show-youtube-button]} state
         is-dark? (= theme-mode mat.ThemeMode/dark)
         ranked (st/rank-results search-results (or last-searched search-query ""))
         display-results (vec
                          (cond
                            (contains? active-filters "Ambos")
                            (filter (fn [item] (contains? enabled-sources (:source item))) ranked)

                            :else
                            (filter (fn [item] (contains? active-filters (:source item))) ranked)))
         suggestions (when (and (not (str/blank? search-query))
                                (not= search-query last-searched)
                                (not is-loading))
                       (st/suggestions-for search-query 6))]
     (mat/Scaffold.
      .resizeToAvoidBottomInset false
      .appBar (mat/AppBar.
               .title (mat/Text. s/app-title)
               .actions [(mat/IconButton.
                          .icon (mat/Icon. mat.Icons/star)
                          .tooltip s/favorites-title
                          .onPressed (fn []
                                       (mat/Navigator.push
                                        ctx
                                        (mat/MaterialPageRoute. .builder (fn [ctx] (favorites-screen))))
                                       nil))
                         (mat/IconButton.
                          .icon (mat/Icon. (if is-dark? mat.Icons/light_mode mat.Icons/dark_mode))
                          .onPressed (fn []
                                       (st/toggle-theme!)
                                       nil))
                         (mat/IconButton.
                          .icon (mat/Icon. mat.Icons/settings)
                          .onPressed (fn []
                                       (mat/Navigator.push
                                        ctx
                                        (mat/MaterialPageRoute. .builder (fn [ctx] (settings/settings-screen))))
                                       nil))])
      .floatingActionButton (when show-youtube-button
                              (mat/FloatingActionButton.extended
                               .onPressed (fn []
                                            (st/open-youtube-search! search-query)
                                            nil)
                               .backgroundColor (mat/Color. 0xFF1565C0)
                               .icon (mat/Icon. mat.Icons/play_circle_filled .color mat.Colors/white)
                               .label (mat/Text. s/youtube-button .style (mat/TextStyle. .color mat.Colors/white .fontWeight mat.FontWeight/bold))
                               .tooltip s/youtube-tooltip))
      .body (mat/Column.
             .children
             (remove nil?
               [(mat/Padding.
                  .padding (mat/EdgeInsets.all 16)
                  .child (mat/Row.
                          .children
                          [(mat/Expanded.
                            .child (mat/TextField.
                                    .controller search-controller
                                    .decoration (mat/InputDecoration.
                                                 .labelText s/search-label
                                                 .border (mat/OutlineInputBorder.)
                                                 .suffixIcon (when-not (str/blank? search-query)
                                                               (mat/IconButton.
                                                                .icon (mat/Icon. mat.Icons/clear .size 20.0)
                                                                .onPressed (fn []
                                                                             (.clear ^mat/TextEditingController search-controller)
                                                                             (swap! st/app-state assoc :search-query "")
                                                                             nil))))
                                    .textInputAction mat.TextInputAction/search
                                    .onChanged #(swap! st/app-state assoc :search-query %)
                                    .onSubmitted (fn [val]
                                                   (st/perform-search! val)
                                                   nil)))
                           (mat/SizedBox. .width 8)
                           (mat/ElevatedButton.
                            .onPressed (fn []
                                         (st/perform-search! search-query)
                                         nil)
                            .child (mat/Text. s/search-button))]))
                (when (seq suggestions)
                  (suggestion-list suggestions search-controller))
                (filter-chips active-filters enabled-sources is-dark?)
                (when (seq failed-sources)
                  (failed-sources-banner failed-sources))
                (if is-loading
                  (mat/LinearProgressIndicator.)
                  (mat/SizedBox.shrink))
                (mat/Expanded.
                 .child (cond
                          error-message
                          (mat/Center.
                           .child (mat/Padding.
                                   .padding (mat/EdgeInsets.all 32.0)
                                   .child (mat/Column.
                                           .mainAxisAlignment mat.MainAxisAlignment/center
                                           .crossAxisAlignment mat.CrossAxisAlignment/center
                                           .children
                                           [(mat/Icon. mat.Icons/wifi_off
                                                       .size 56
                                                       .color (.-shade400 mat.Colors/red))
                                            (mat/SizedBox. .height 16)
                                            (mat/Text.
                                             error-message
                                             .style (mat/TextStyle.
                                                     .fontSize 15
                                                     .color (.-shade700 mat.Colors/red))
                                             .textAlign mat.TextAlign/center)
                                            (mat/SizedBox. .height 16)
                                            (mat/ElevatedButton.
                                             .onPressed (fn []
                                                          (st/perform-search! search-query)
                                                          nil)
                                             .child (mat/Text. s/try-again))])))

                          (and (empty? display-results) (not is-loading))
                          (mat/Center.
                           .child (mat/SingleChildScrollView.
                                   .padding (mat/EdgeInsets.all 32.0)
                                   .child (mat/Column.
                                           .mainAxisAlignment mat.MainAxisAlignment/center
                                           .crossAxisAlignment mat.CrossAxisAlignment/center
                                           .children
                                           (remove nil?
                                             [(mat/Icon. (if (str/blank? search-query) mat.Icons/search mat.Icons/search_off)
                                                         .size 64
                                                         .color (.-shade400 mat.Colors/grey))
                                              (mat/SizedBox. .height 16)
                                              (mat/Text.
                                               (if (str/blank? search-query)
                                                 s/type-to-search
                                                 (s/no-results-for search-query))
                                               .style (mat/TextStyle.
                                                       .fontSize 16
                                                       .fontWeight mat.FontWeight/w500
                                                       .color (.-shade600 mat.Colors/grey))
                                               .textAlign mat.TextAlign/center)
                                              (when (and (not (str/blank? search-query)) show-youtube-button)
                                                (mat/Column.
                                                 .mainAxisSize mat.MainAxisSize/min
                                                 .children
                                                 [(mat/Padding.
                                                   .padding (mat/EdgeInsets.only .top 8.0)
                                                   .child (mat/Text.
                                                           s/not-found-dictionaries
                                                           .style (mat/TextStyle.
                                                                   .fontSize 14
                                                                   .color (.-shade500 mat.Colors/grey))
                                                           .textAlign mat.TextAlign/center))
                                                  (mat/TextButton.
                                                   .onPressed (fn []
                                                                (st/open-youtube-search! search-query)
                                                                nil)
                                                   .child (mat/Row.
                                                           .mainAxisSize mat.MainAxisSize/min
                                                           .children
                                                           [(mat/Icon. mat.Icons/play_circle_filled
                                                                       .size 18
                                                                       .color (mat/Color. 0xFF1565C0))
                                                            (mat/SizedBox. .width 6)
                                                            (mat/Text. s/search-youtube
                                                                       .style (mat/TextStyle.
                                                                               .color (mat/Color. 0xFF1565C0)
                                                                               .fontWeight mat.FontWeight/w600))]))]))
                                              (when (and (str/blank? search-query) (seq recent-searches))
                                                (recent-searches-block recent-searches search-controller))]))))
                          :else
                          (mat/ListView.builder
                           .itemCount (count display-results)
                           .itemBuilder (fn [ctx idx]
                                          (card/dictionary-item-card (get display-results idx))))))]))))))

(defn main-app []
  (f/widget
   :watch [state st/app-state]
   (mat/MaterialApp.
    .title s/app-title
    .debugShowCheckedModeBanner false
    .themeMode (:theme-mode state)
    .theme (mat/ThemeData. .useMaterial3 true .brightness mat.Brightness/light .colorScheme (mat.ColorScheme/fromSeed .seedColor mat.Colors/blue))
    .darkTheme (mat/ThemeData. .useMaterial3 true .brightness mat.Brightness/dark .colorScheme (mat.ColorScheme/fromSeed .seedColor mat.Colors/blue .brightness mat.Brightness/dark))
    .home (home-page))))

(defn main []
  (mat.WidgetsFlutterBinding/ensureInitialized)
  (await (st/load-settings!))
  ;; Fire-and-forget: warms autocomplete + offline cache in background.
  (st/preload-ines!)
  (mat/runApp (main-app)))
