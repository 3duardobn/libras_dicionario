(ns libras-dictionary.main
  (:require [cljd.flutter :as f]
            [libras-dictionary.api :as api]
            [libras-dictionary.models :as m]
            [clojure.string :as str]
            ["package:flutter/material.dart" :as mat]
            ["package:shared_preferences/shared_preferences.dart" :as prefs]
            ["package:flutter_svg/flutter_svg.dart" :as svg]
            ["package:url_launcher/url_launcher.dart" :as url-l]
            ["package:video_player/video_player.dart" :as v-p]
            ["package:chewie/chewie.dart" :as chewie]
            ["package:youtube_player_flutter/youtube_player_flutter.dart" :as yt-p]
            ["package:flutter_html/flutter_html.dart" :as html]
            ["package:flutter/services.dart" :as services]
            ["dart:async" :as async]))

;; --- Global State ---
(defonce app-state
  (atom
   {:theme-mode mat.ThemeMode/light
    :search-query ""
    :is-loading false
    :is-youtube-search false
    :search-results []
    :error-message nil
    :enabled-sources #{"INES" "UFV" "RedeSurdos" "LibrasAcademicaUFF" "SpreadTheSign"}
    :active-filters #{"Ambos"}
    :auto-youtube-search false
    :is-share-minimal false}))

;; --- Share Integration ---
(def ^services/MethodChannel share-channel (services/MethodChannel. "com.example.libras_dictionary/share"))

(defn share! [text subject]
  (try
    (await (.invokeMethod share-channel "share" {"text" text "subject" subject}))
    (catch services/PlatformException e
      (println "Failed to share:" (.-message ^services/PlatformException e)))))

;; --- Actions ---
(defn load-settings! []
  (let [p (await (prefs.SharedPreferences/getInstance))
        is-dark (or (.getBool p "isDark") false)
        enabled-sources (.getStringList p "enabled_sources")
        auto-yt (or (.getBool p "auto_youtube_search") false)
        share-min (or (.getBool p "is_share_minimal") false)]
    (swap! app-state assoc
           :theme-mode (if is-dark mat.ThemeMode/dark mat.ThemeMode/light)
           :enabled-sources (if (and enabled-sources (not (empty? enabled-sources)))
                              (set (seq enabled-sources))
                              #{"INES" "UFV" "RedeSurdos" "LibrasAcademicaUFF" "SpreadTheSign"})
           :auto-youtube-search auto-yt
           :is-share-minimal share-min
           :active-filters #{"Ambos"})))

(defn toggle-theme! []
  (let [new-mode (if (= (:theme-mode @app-state) mat.ThemeMode/light) mat.ThemeMode/dark mat.ThemeMode/light)]
    (swap! app-state assoc :theme-mode new-mode)
    (-> (prefs.SharedPreferences/getInstance)
        (.then (fn [p]
                 (.setBool ^prefs/SharedPreferences p "isDark" (= new-mode mat.ThemeMode/dark)))))
    nil))

(defn perform-youtube-search! [query]
  (when-not (str/blank? query)
    (swap! app-state assoc :is-loading true :is-youtube-search true :search-results [] :error-message nil)
    (try
      (println "=== START YOUTUBE SEARCH ===" query)
      (let [results (await (api/search-youtube query))]
        (println "=== YOUTUBE SEARCH RESULTS ===" (count results))
        (swap! app-state assoc :search-results results :is-loading false))
      (catch Exception e
        (println "Error searching YouTube:" e)
        (swap! app-state assoc :is-loading false :error-message "Não foi possível completar a busca. Verifique sua conexão e tente novamente.")))))

(defn perform-search! [query]
  (when-not (str/blank? query)
    (swap! app-state assoc :is-loading true :is-youtube-search false :search-results [] :error-message nil)
    (try
      (println "=== START DICTIONARY SEARCH ===" query)
      (println "Enabled sources on search:" (:enabled-sources @app-state))
      (let [results (await (api/search-all query))]
        (println "=== DICTIONARY SEARCH RESULTS ===" (count results))
        (doseq [r results]
          (println "  - Title:" (:title r) "Source:" (:source r)))
        (if (and (empty? results) (:auto-youtube-search @app-state))
          (do
            (println "No results found. Auto YouTube search is active, searching YouTube...")
            (await (perform-youtube-search! query)))
          (swap! app-state assoc :search-results results :is-loading false)))
      (catch Exception e
        (println "Error performing search:" e)
        (swap! app-state assoc :is-loading false :error-message "Não foi possível completar a busca. Verifique sua conexão e tente novamente.")))))

(defn on-filter-changed! [filter-name selected]
  (swap! app-state
         (fn [state]
           (let [enabled (:enabled-sources state)
                 current (:active-filters state #{"Ambos"})
                 next-filters (if (= filter-name "Ambos")
                                #{"Ambos"}
                                (let [updated (if selected
                                                (conj (disj current "Ambos") filter-name)
                                                (disj current filter-name))]
                                  (if (or (empty? updated)
                                          (every? #(contains? updated %) enabled))
                                    #{"Ambos"}
                                    updated)))]
             (assoc state :active-filters next-filters)))))

;; --- UI Helpers ---
(defn ^mat/Color get-source-color [source]
  (case source
    "INES" (.-shade600 mat.Colors/blue)
    "RedeSurdos" (.-shade600 mat.Colors/green)
    "UFV" (.-shade600 mat.Colors/red)
    "LibrasAcademicaUFF" (.-shade600 mat.Colors/purple)
    "SpreadTheSign" (.-shade600 mat.Colors/orange)
    "YouTube" (.-shade800 mat.Colors/red)
    (.-shade600 mat.Colors/grey)))

(defn launch-url! [url-str]
  (let [uri (Uri/parse url-str)]
    (when (await (url-l/launchUrl uri))
      nil)))

(defn build-source-credit [name org url copyright]
  (mat/Padding.
   .padding (mat/EdgeInsets.symmetric .horizontal 16.0 .vertical 8.0)
   .child (mat/Column.
           .crossAxisAlignment mat.CrossAxisAlignment/start
           .children
           [(mat/Text. name .style (mat/TextStyle. .fontWeight mat.FontWeight/bold))
            (mat/Text. org .style (mat/TextStyle. .fontSize 12))
            (mat/InkWell.
             .onTap (fn []
                      (launch-url! url)
                      nil)
             .child (mat/Text. url .style (mat/TextStyle. .color (mat/Color. 0xFF1565C0) .fontSize 12)))
            (mat/Text. copyright .style (mat/TextStyle. .fontSize 11 .fontStyle mat.FontStyle/italic))
            (mat/SizedBox. .height 8)])))

;; --- Video Widgets ---
(defn youtube-player-widget [youtube-id]
  (f/widget
   :managed [player-state
             (let [replaying? (atom false)
                   controller (yt-p/YoutubePlayerController.
                               .initialVideoId youtube-id
                               .flags (yt-p/YoutubePlayerFlags.
                                       .autoPlay false
                                       .mute false
                                       .loop false
                                       .hideControls false
                                       .hideThumbnail true
                                       .controlsVisibleAtStart true
                                       .disableDragSeek true))
                   listener (fn []
                              (let [value ^yt-p/YoutubePlayerValue (.-value controller)]
                                (when (.-isReady value)
                                  (let [position ^Duration (.-position value)
                                        duration ^Duration (-> value .-metaData .-duration)]
                                    (if (and (> (.-inMilliseconds duration) 0)
                                             (>= (.-inMilliseconds position) (- (.-inMilliseconds duration) 300))
                                             (not @replaying?))
                                      (do
                                        (reset! replaying? true)
                                        (.seekTo controller (Duration. .seconds 0))
                                        (Future/delayed (Duration. .milliseconds 600)
                                                        (fn [] (reset! replaying? false))))
                                      (when (and (= (.-playerState value) yt-p.PlayerState/ended)
                                                 (not @replaying?))
                                        (reset! replaying? true)
                                        (.seekTo controller (Duration. .seconds 0))
                                        (.play controller)
                                        (Future/delayed (Duration. .milliseconds 600)
                                                        (fn [] (reset! replaying? false)))))))))]
               (.addListener controller listener)
               {:controller controller :listener listener})
             :refresh-on youtube-id
             :dispose ((fn [state]
                         (let [c (:controller state)
                               l (:listener state)]
                           (.removeListener ^yt-p/YoutubePlayerController c l)
                           (.dispose ^yt-p/YoutubePlayerController c))))]
   (yt-p/YoutubePlayer.
    .controller (:controller player-state)
    .showVideoProgressIndicator true)))

(defn chewie-video-widget [video-url]
  (f/widget
   :managed [state-atom
             (let [state (atom {:video-controller nil
                                :chewie-controller nil
                                :is-loading true
                                :has-error false})
                   init-player! (fn [url-str]
                                  (try
                                    (let [uri (Uri/parse url-str)
                                          ts (.toString (.-millisecondsSinceEpoch (DateTime/now)))
                                          query-params (assoc (into {} (.-queryParameters uri)) "v" ts)
                                          final-uri (.replace uri .queryParameters query-params)
                                          vc (v-p/VideoPlayerController.networkUrl final-uri
                                                                                   .httpHeaders {"User-Agent" "Mozilla/5.0" "Accept" "*/*"})]
                                      (await (.initialize vc))
                                      (await (.setVolume vc 0.0))
                                      (let [cc (chewie/ChewieController.
                                                .videoPlayerController vc
                                                .autoPlay true
                                                .looping true
                                                .aspectRatio (-> vc .-value .-aspectRatio)
                                                .showControls true
                                                .errorBuilder (fn [ctx err-msg]
                                                                (mat/Center. .child (mat/Text. err-msg .style (mat/TextStyle. .color mat.Colors/white)))))]
                                        (swap! state assoc :video-controller vc :chewie-controller cc :is-loading false)))
                                    (catch Exception e
                                      (println "Error initializing video:" e)
                                      (swap! state assoc :has-error true :is-loading false))))]
                         (init-player! video-url)
                         state)
             :refresh-on video-url
             :dispose ((fn [state-atom]
                         (let [state @state-atom]
                           (when-let [vc ^v-p/VideoPlayerController (:video-controller state)]
                             (.dispose vc))
                           (when-let [cc ^chewie/ChewieController (:chewie-controller state)]
                             (.dispose cc)))))]
   :watch [state state-atom]
   :let [{:keys [video-controller chewie-controller is-loading has-error]} state]
   (cond
     has-error
     (mat/Padding.
      .padding (mat/EdgeInsets.all 16.0)
      .child (mat/Center.
              .child (mat/Text. "Erro ao carregar o vídeo."
                                .style (mat/TextStyle. .color mat.Colors/red)
                                .textAlign mat.TextAlign/center)))

     (and (not is-loading) chewie-controller video-controller (-> ^v-p/VideoPlayerController video-controller .-value .-isInitialized))
     (mat/AspectRatio.
      .aspectRatio (-> ^v-p/VideoPlayerController video-controller .-value .-aspectRatio)
      .child (chewie/Chewie. .controller chewie-controller))

     :else
     (mat/Padding.
      .padding (mat/EdgeInsets.all 16.0)
      .child (mat/Center. .child (mat/CircularProgressIndicator.))))))

;; --- UI Widgets ---
(defn dictionary-item-card [item]
  (f/widget
   :watch [is-expanded (atom false) :as expanded?]
   (mat/Card.
    .margin (mat/EdgeInsets.symmetric .horizontal 16 .vertical 8)
    .elevation 3
    .shape (mat/RoundedRectangleBorder. .borderRadius (mat/BorderRadius.circular 12))
    .clipBehavior mat.Clip/antiAlias
    .child (mat/InkWell.
            .onTap #(swap! expanded? not)
            .child (mat/Column.
                    .mainAxisSize mat.MainAxisSize/min
                    .crossAxisAlignment mat.CrossAxisAlignment/stretch
                    .children
                    [(mat/Container.
                      .padding (mat/EdgeInsets.symmetric .horizontal 16.0 .vertical 12.0)
                      .color (get-source-color (:source item))
                      .child (mat/Row.
                              .mainAxisAlignment mat.MainAxisAlignment/spaceBetween
                              .children
                              (cond-> [(mat/Expanded.
                                        .child (mat/Text. (str (:title item) " (" (:source item) ")")
                                                          .style (mat/TextStyle. .fontWeight mat.FontWeight/bold .fontSize 20 .color mat.Colors/white)))]
                                (:link item)
                                (conj (mat/IconButton.
                                       .icon (mat/Icon. mat.Icons/share .color mat.Colors/white)
                                       .tooltip "Compartilhar sinal"
                                       .onPressed
                                       (fn []
                                         (let [share-text (if (:is-share-minimal @app-state)
                                                            (str (:title item) ": " (:link item))
                                                            (str "Veja este sinal de Libras para \"" (:title item) "\": " (:link item)))]
                                           (share! share-text (str "Sinal de Libras: " (:title item)))
                                           nil))))
                                true
                                (conj (mat/Icon. (if is-expanded mat.Icons/expand_less mat.Icons/expand_more) .color mat.Colors/white)))))
                     (if is-expanded
                       (mat/Padding.
                        .padding (mat/EdgeInsets.all 16)
                        .child (mat/Column.
                                .crossAxisAlignment mat.CrossAxisAlignment/start
                                .children
                                (cond-> []
                                  (not (str/blank? (:description item)))
                                  (conj (mat/Column.
                                         .crossAxisAlignment mat.CrossAxisAlignment/start
                                         .children
                                         [(mat/Text. "Descrição:" .style (mat/TextStyle. .fontWeight mat.FontWeight/bold .fontSize 16))
                                          (mat/SizedBox. .height 4)
                                          (html/Html.
                                           .data (:description item)
                                           .style {"body" (html/Style.
                                                           .margin html.Margins/zero
                                                           .padding html.HtmlPaddings/zero
                                                           .fontSize (html/FontSize. 16.0))})
                                          (mat/SizedBox. .height 12)]))

                                  (not (str/blank? (:exemplo item)))
                                  (conj (mat/Column.
                                         .crossAxisAlignment mat.CrossAxisAlignment/start
                                         .children
                                         [(mat/Text. "Exemplo:" .style (mat/TextStyle. .fontWeight mat.FontWeight/bold .fontSize 16))
                                          (mat/SizedBox. .height 4)
                                          (html/Html.
                                           .data (:exemplo item)
                                           .style {"body" (html/Style.
                                                           .margin html.Margins/zero
                                                           .padding html.HtmlPaddings/zero
                                                           .fontSize (html/FontSize. 16.0)
                                                           .fontStyle mat.FontStyle/italic)})
                                          (mat/SizedBox. .height 12)]))

                                  (not (str/blank? (:libras item)))
                                  (conj (mat/Column.
                                         .crossAxisAlignment mat.CrossAxisAlignment/start
                                         .children
                                         [(mat/Text. "Tradução Libras (Glosa):" .style (mat/TextStyle. .fontWeight mat.FontWeight/bold .fontSize 16))
                                          (mat/SizedBox. .height 4)
                                          (mat/Container.
                                           .padding (mat/EdgeInsets.all 8.0)
                                           .decoration (mat/BoxDecoration.
                                                        .color (.-shade100 mat.Colors/grey)
                                                        .borderRadius (mat/BorderRadius.circular 8)
                                                        .border (mat/Border.all .color (.-shade300 mat.Colors/grey)))
                                           .child (mat/Text.
                                                   (:libras item)
                                                   .style (mat/TextStyle.
                                                           .fontFamily "monospace"
                                                           .fontSize 14.0
                                                           .fontWeight mat.FontWeight/w600)))
                                          (mat/SizedBox. .height 12)]))

                                  (not (str/blank? (:youtube-id item)))
                                  (conj (mat/Padding.
                                         .padding (mat/EdgeInsets.only .bottom 16.0)
                                         .child (youtube-player-widget (:youtube-id item))))

                                  (not (str/blank? (:image-url item)))
                                  (conj (mat/Padding.
                                         .padding (mat/EdgeInsets.only .bottom 16.0)
                                         .child (mat/Image.network
                                                 (:image-url item)
                                                 .fit mat.BoxFit/contain
                                                 .errorBuilder (fn [ctx err stack] (mat/SizedBox.shrink)))))

                                  (not (str/blank? (:video-url item)))
                                  (conj (mat/Padding.
                                         .padding (mat/EdgeInsets.only .bottom 16.0)
                                         .child (chewie-video-widget (:video-url item)))))))
                       (mat/SizedBox.shrink))])))))

(defn settings-screen []
  (f/widget
   :context ctx
   :watch [state app-state]
   (let [{:keys [enabled-sources auto-youtube-search is-share-minimal]} state
         source-labels {"INES" "INES (Dicionário INES)"
                        "UFV" "UFV (Universidade Federal de Viçosa)"
                        "RedeSurdos" "Rede Surdos (UFC)"
                        "LibrasAcademicaUFF" "Libras Acadêmica (UFF)"
                        "SpreadTheSign" "SpreadTheSign"}]
     (mat/Scaffold.
      .appBar (mat/AppBar. .title (mat/Text. "Configurações"))
      .body (mat/ListView.
             .children
             [(mat/ListTile. .title (mat/Text. "Configurações de Busca" .style (mat/TextStyle. .fontWeight mat.FontWeight/bold)))
              (mat/SwitchListTile.
               .title (mat/Text. "Busca automática no YouTube")
               .subtitle (mat/Text. "Se não encontrar nada nos dicionários, busca no YouTube")
               .value auto-youtube-search
               .onChanged (fn [val]
                            (swap! app-state assoc :auto-youtube-search val)
                            (-> (prefs.SharedPreferences/getInstance)
                                (.then (fn [p]
                                         (.setBool ^prefs/SharedPreferences p "auto_youtube_search" val))))
                            nil))
              (mat/SwitchListTile.
               .title (mat/Text. "Texto de compartilhamento mínimo")
               .subtitle (mat/Text. "Envia apenas a palavra e o link ao compartilhar")
               .value is-share-minimal
               .onChanged (fn [val]
                            (swap! app-state assoc :is-share-minimal val)
                            (-> (prefs.SharedPreferences/getInstance)
                                (.then (fn [p]
                                         (.setBool ^prefs/SharedPreferences p "is_share_minimal" val))))
                            nil))
              (mat/Divider.)
              (mat/ListTile.
               .title (mat/Text. "Fontes de Pesquisa" .style (mat/TextStyle. .fontWeight mat.FontWeight/bold))
               .subtitle (mat/Text. "Ative ou desative as fontes de palavras"))
              (mat/Column.
               .mainAxisSize mat.MainAxisSize/min
               .children
               (map
                (fn [source]
                  (mat/SwitchListTile.
                   .title (mat/Text. (get source-labels source source))
                   .value (contains? enabled-sources source)
                   .secondary (mat/Container.
                               .width 24
                               .height 24
                               .decoration (mat/BoxDecoration.
                                            .color (get-source-color source)
                                            .shape mat.BoxShape/circle))
                   .onChanged (fn [val]
                                (let [new-sources (if val
                                                    (conj enabled-sources source)
                                                    (disj enabled-sources source))]
                                  (swap! app-state assoc :enabled-sources new-sources)
                                  (-> (prefs.SharedPreferences/getInstance)
                                      (.then (fn [p]
                                               (.setStringList ^prefs/SharedPreferences p "enabled_sources" (vec new-sources)))))
                                  nil))))
                ["INES" "UFV" "RedeSurdos" "LibrasAcademicaUFF" "SpreadTheSign"]))
              (mat/Divider.)
              (mat/ListTile.
               .title (mat/Text. "Direitos Reservados" .style (mat/TextStyle. .fontWeight mat.FontWeight/bold))
               .subtitle (mat/Text. "Créditos e fontes de dados"))
              (build-source-credit "INES" "Instituto Nacional de Educação de Surdos" "http://dicionario.ines.gov.br/" "Os direitos autorais dos vídeos e imagens pertencem ao INES. O uso neste aplicativo é para fins educacionais e de acessibilidade.")
              (build-source-credit "Rede Surdos" "Universidade Federal do Ceará (UFC)" "https://redesurdosce.ufc.br/" "Conteúdo disponibilizado pela Rede Surdos da UFC. Todos os direitos reservados aos produtores originais.")
              (build-source-credit "UFV" "Universidade Federal de Viçosa" "https://sistemas.cead.ufv.br/capes/dicionario/" "Dicionário de Libras da UFV. Conteúdo protegido por direitos autorais da instituição.")
              (build-source-credit "Libras Acadêmica" "Universidade Federal Fluminense (UFF)" "https://librasacademica.uff.br/" "Glossário de Libras Acadêmica da UFF. Direitos reservados à UFF.")
              (build-source-credit "SpreadTheSign" "European Sign Language Centre" "https://www.spreadthesign.com/" "SpreadTheSign é um dicionário internacional. Os direitos pertencem ao European Sign Language Centre.")
              (build-source-credit "Ícone de Libras" "Wikimedia Commons" "https://en.wikipedia.org/wiki/File:Brazilian_Sign_Language_Symbol.svg" "O símbolo da Língua Brasileira de Sinais usado neste projeto está disponível sob a licença Creative Commons CC0 1.0 Universal Public Domain Dedication.")
              (mat/Divider.)
              (mat/ListTile. .title (mat/Text. "Licença do Projeto" .style (mat/TextStyle. .fontWeight mat.FontWeight/bold)))
              (mat/Padding.
               .padding (mat/EdgeInsets.symmetric .horizontal 16.0)
               .child (mat/Column.
                       .crossAxisAlignment mat.CrossAxisAlignment/start
                       .children
                       [(mat/Text. "Este projeto é de domínio público (CC0).")
                        (mat/SizedBox. .height 8)
                        (mat/InkWell.
                         .onTap (fn []
                                  (launch-url! "https://github.com/3duardobn/libras_dicionario")
                                  nil)
                         .child (mat/Text. "Repositório no GitHub" .style (mat/TextStyle. .color (mat/Color. 0xFF1565C0) .decoration mat.TextDecoration/underline)))
                        (mat/SizedBox. .height 16)]))
              (mat/Divider.)])))))

(defn home-page []
  (f/widget
   :context ctx
   :managed [search-controller
             (mat/TextEditingController.)
             :dispose ((fn [c] (.dispose ^mat/TextEditingController c)))]
   :watch [state app-state]
   (let [{:keys [theme-mode is-loading search-results search-query active-filters enabled-sources is-youtube-search error-message]} state
         is-dark? (= theme-mode mat.ThemeMode/dark)
         display-results (vec
                          (cond
                            is-youtube-search
                            search-results

                            (contains? active-filters "Ambos")
                            (filter (fn [item] (contains? enabled-sources (:source item))) search-results)

                            :else
                            (filter (fn [item] (contains? active-filters (:source item))) search-results)))]
     (mat/Scaffold.
      .resizeToAvoidBottomInset false
      .appBar (mat/AppBar.
               .title (mat/Text. "Dicionário Libras")
               .actions [(mat/IconButton.
                          .icon (mat/Icon. (if is-dark? mat.Icons/light_mode mat.Icons/dark_mode))
                          .onPressed (fn []
                                       (toggle-theme!)
                                       nil))
                         (mat/IconButton.
                          .icon (mat/Icon. mat.Icons/settings)
                          .onPressed (fn []
                                       (mat/Navigator.push
                                        ctx
                                        (mat/MaterialPageRoute. .builder (fn [ctx] (settings-screen))))
                                       nil))])
      .floatingActionButton (mat/FloatingActionButton.extended
                             .onPressed (fn []
                                          (perform-youtube-search! search-query)
                                          nil)
                             .backgroundColor (mat/Color. 0xFF1565C0)
                             .icon (mat/Icon. mat.Icons/play_circle_filled .color mat.Colors/white)
                             .label (mat/Text. "YouTube" .style (mat/TextStyle. .color mat.Colors/white .fontWeight mat.FontWeight/bold))
                             .tooltip "Buscar no YouTube")
      .body (mat/Column.
             .children
             (remove nil?
               [(mat/Padding.
                  .padding (mat/EdgeInsets.all 16)
                  .child (mat/Row.
                          .children
                          [(mat/Expanded.
                            .child (mat/TextField.
                                    .controller search-controller
                                    .decoration (mat/InputDecoration.
                                                 .labelText "Pesquisar (Português)"
                                                 .border (mat/OutlineInputBorder.)
                                                 .suffixIcon (when-not (str/blank? search-query)
                                                               (mat/IconButton.
                                                                .icon (mat/Icon. mat.Icons/clear .size 20.0)
                                                                .onPressed (fn []
                                                                             (.clear ^mat/TextEditingController search-controller)
                                                                             (swap! app-state assoc :search-query "")
                                                                             nil))))
                                    .textInputAction mat.TextInputAction/search
                                    .onChanged #(swap! app-state assoc :search-query %)
                                    .onSubmitted (fn [val]
                                                   (perform-search! val)
                                                   nil)))
                           (mat/SizedBox. .width 8)
                           (mat/ElevatedButton.
                            .onPressed (fn []
                                         (perform-search! search-query)
                                         nil)
                            .child (mat/Text. "Buscar"))]))
                (when-not is-youtube-search
                  (mat/Padding.
                   .padding (mat/EdgeInsets.symmetric .horizontal 16.0 .vertical 8.0)
                   .child
                   (mat/Wrap.
                    .spacing 8.0
                    .runSpacing 8.0
                    .alignment mat.WrapAlignment/center
                    .children
                    (into
                     [(let [is-selected? (contains? active-filters "Ambos")]
                        (mat/FilterChip.
                         .label (mat/Text. "Todos"
                                           .style (mat/TextStyle.
                                                   .fontSize 13
                                                   .fontWeight mat.FontWeight/bold
                                                   .color (if is-selected? mat.Colors/white (if is-dark? mat.Colors/white (mat/Color. 0xFF1C1B1F)))))
                         .selected is-selected?
                         .onSelected (fn [val]
                                       (on-filter-changed! "Ambos" val)
                                       nil)
                         .showCheckmark false
                         .selectedColor (.-shade600 mat.Colors/blue)
                         .backgroundColor (.withOpacity (.-shade600 mat.Colors/grey) 0.2)
                         .shape (mat/RoundedRectangleBorder. .borderRadius (mat/BorderRadius.circular 8))
                         .elevation 1
                         .pressElevation 2
                         .padding (mat/EdgeInsets.symmetric .horizontal 8.0 .vertical 6.0)))]
                     (map
                      (fn [source]
                        (let [is-selected? (contains? active-filters source)
                              display-label (case source
                                              "RedeSurdos" "Rede Surdos"
                                              "LibrasAcademicaUFF" "Libras Acadêmica"
                                              source)]
                          (mat/FilterChip.
                           .label (mat/Text. display-label
                                              .style (mat/TextStyle.
                                                      .fontSize 13
                                                      .color (if is-selected? mat.Colors/white (if is-dark? mat.Colors/white (mat/Color. 0xFF1C1B1F)))))
                           .selected is-selected?
                           .onSelected (fn [val]
                                         (on-filter-changed! source val)
                                         nil)
                           .showCheckmark false
                           .selectedColor (get-source-color source)
                           .backgroundColor (.withOpacity (.-shade600 mat.Colors/grey) 0.2)
                           .shape (mat/RoundedRectangleBorder. .borderRadius (mat/BorderRadius.circular 8))
                           .elevation 1
                           .pressElevation 2
                           .padding (mat/EdgeInsets.symmetric .horizontal 8.0 .vertical 6.0))))
                      (sort (seq enabled-sources)))))))
                (if is-loading
                  (mat/LinearProgressIndicator.)
                  (mat/SizedBox.shrink))
                (mat/Expanded.
                 .child (cond
                          error-message
                          (mat/Center.
                           .child (mat/Padding.
                                   .padding (mat/EdgeInsets.all 32.0)
                                   .child (mat/Column.
                                           .mainAxisAlignment mat.MainAxisAlignment/center
                                           .crossAxisAlignment mat.CrossAxisAlignment/center
                                           .children
                                           [(mat/Icon. mat.Icons/wifi_off
                                                       .size 56
                                                       .color (.-shade400 mat.Colors/red))
                                            (mat/SizedBox. .height 16)
                                            (mat/Text.
                                             error-message
                                             .style (mat/TextStyle.
                                                     .fontSize 15
                                                     .color (.-shade700 mat.Colors/red))
                                             .textAlign mat.TextAlign/center)
                                            (mat/SizedBox. .height 16)
                                            (mat/ElevatedButton.
                                             .onPressed (fn []
                                                          (perform-search! search-query)
                                                          nil)
                                             .child (mat/Text. "Tentar novamente"))])))

                          (and (empty? display-results) (not is-loading))
                          (mat/Center.
                           .child (mat/Padding.
                                   .padding (mat/EdgeInsets.all 32.0)
                                   .child (mat/Column.
                                           .mainAxisAlignment mat.MainAxisAlignment/center
                                           .crossAxisAlignment mat.CrossAxisAlignment/center
                                           .children
                                           (remove nil?
                                             [(mat/Icon. (if (str/blank? search-query) mat.Icons/search mat.Icons/search_off)
                                                         .size 64
                                                         .color (.-shade400 mat.Colors/grey))
                                              (mat/SizedBox. .height 16)
                                              (mat/Text.
                                               (if (str/blank? search-query)
                                                 "Digite uma palavra acima para pesquisar"
                                                 (str "Nenhum resultado encontrado para \"" search-query "\""))
                                               .style (mat/TextStyle.
                                                       .fontSize 16
                                                       .fontWeight mat.FontWeight/w500
                                                       .color (.-shade600 mat.Colors/grey))
                                               .textAlign mat.TextAlign/center)
                                              (when (and (not (str/blank? search-query)) (not is-youtube-search))
                                                (mat/Column.
                                                 .mainAxisSize mat.MainAxisSize/min
                                                 .children
                                                 [(mat/Padding.
                                                   .padding (mat/EdgeInsets.only .top 8.0)
                                                   .child (mat/Text.
                                                           "Não encontrado nos dicionários."
                                                           .style (mat/TextStyle.
                                                                   .fontSize 14
                                                                   .color (.-shade500 mat.Colors/grey))
                                                           .textAlign mat.TextAlign/center))
                                                  (mat/TextButton.
                                                   .onPressed (fn []
                                                                (perform-youtube-search! search-query)
                                                                nil)
                                                   .child (mat/Row.
                                                           .mainAxisSize mat.MainAxisSize/min
                                                           .children
                                                           [(mat/Icon. mat.Icons/play_circle_filled
                                                                       .size 18
                                                                       .color (mat/Color. 0xFF1565C0))
                                                            (mat/SizedBox. .width 6)
                                                            (mat/Text. "Buscar no YouTube"
                                                                       .style (mat/TextStyle.
                                                                               .color (mat/Color. 0xFF1565C0)
                                                                               .fontWeight mat.FontWeight/w600))]))]))]))))
                          :else
                          (mat/ListView.builder
                           .itemCount (count display-results)
                           .itemBuilder (fn [ctx idx]
                                          (dictionary-item-card (get display-results idx))))))]))))))

(defn main-app []
  (f/widget
   :watch [state app-state]
   (mat/MaterialApp.
    .title "Dicionário Libras"
    .debugShowCheckedModeBanner false
    .themeMode (:theme-mode state)
    .theme (mat/ThemeData. .useMaterial3 true .brightness mat.Brightness/light .colorScheme (mat.ColorScheme/fromSeed .seedColor mat.Colors/blue))
    .darkTheme (mat/ThemeData. .useMaterial3 true .brightness mat.Brightness/dark .colorScheme (mat.ColorScheme/fromSeed .seedColor mat.Colors/blue .brightness mat.Brightness/dark))
    .home (home-page))))

(defn main []
  (mat.WidgetsFlutterBinding/ensureInitialized)
  (await (load-settings!))
  (mat/runApp (main-app)))
