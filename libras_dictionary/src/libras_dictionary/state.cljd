(ns libras-dictionary.state
  "Global app state, actions and playback coordination."
  (:require [clojure.string :as str]
            [libras-dictionary.api :as api]
            [libras-dictionary.models :as m]
            [libras-dictionary.strings :as s]
            ["package:flutter/material.dart" :as mat]
            ["package:flutter/services.dart" :as services]
            ["package:shared_preferences/shared_preferences.dart" :as prefs]
            ["package:url_launcher/url_launcher.dart" :as url-l]
            ["dart:convert" :as json]))

(def all-sources #{"INES" "UFV" "RedeSurdos" "LibrasAcademicaUFF" "SpreadTheSign"})

(def max-recent-searches 10)

(defonce app-state
  (atom
   {:theme-mode mat.ThemeMode/light
    :search-query ""
    :last-searched nil
    :search-token 0
    :is-loading false
    :search-results []
    :failed-sources []
    :error-message nil
    :recent-searches []
    :favorites []
    :enabled-sources all-sources
    :active-filters #{"Ambos"}
    :is-share-minimal false
    :show-youtube-button true}))

;; --- Playback Coordination ---
;; Only one video plays at a time: starting any player pauses the previous one.
(defonce active-player (atom nil))

(defn claim-playback! [id pause!]
  (let [{prev-id :id prev-pause :pause!} @active-player]
    (when (and prev-pause (not (identical? prev-id id)))
      (try
        (prev-pause)
        (catch Object e
          (api/log "Error pausing previous player:" e))))
    (reset! active-player {:id id :pause! pause!})))

(defn release-playback! [id]
  (swap! active-player (fn [cur] (if (identical? (:id cur) id) nil cur))))

;; --- Favorites ---

(defn- item->json [item]
  (json/json.encode
   {"title" (:title item)
    "description" (:description item)
    "exemplo" (:exemplo item)
    "libras" (:libras item)
    "video_url" (:video-url item)
    "image_url" (:image-url item)
    "youtube_id" (:youtube-id item)
    "link" (:link item)
    "source" (:source item)}))

(defn- json->item [^String encoded]
  (try
    (let [data (json/json.decode encoded)]
      (m/make-dict-item
       :title (get data "title")
       :description (get data "description")
       :exemplo (get data "exemplo")
       :libras (get data "libras")
       :video-url (get data "video_url")
       :image-url (get data "image_url")
       :youtube-id (get data "youtube_id")
       :link (get data "link")
       :source (get data "source")))
    (catch Object e
      (api/log "Could not decode favorite:" e)
      nil)))

(defn- favorite-key [item]
  [(:title item) (:link item) (:source item)])

(defn favorite? [item]
  (boolean (some #(= (favorite-key %) (favorite-key item)) (:favorites @app-state))))

(defn- persist-favorites! [favorites]
  (-> (prefs.SharedPreferences/getInstance)
      (.then (fn [p]
               (.setStringList ^prefs/SharedPreferences p "favorites"
                               (into [] (map item->json) favorites)))))
  nil)

(defn toggle-favorite! [item]
  (let [favorites (:favorites @app-state)
        k (favorite-key item)
        updated (if (some #(= (favorite-key %) k) favorites)
                  (into [] (remove #(= (favorite-key %) k)) favorites)
                  (conj favorites item))]
    (swap! app-state assoc :favorites updated)
    (persist-favorites! updated)))

;; --- Recent searches ---

(defn- persist-recents! [recents]
  (-> (prefs.SharedPreferences/getInstance)
      (.then (fn [p]
               (.setStringList ^prefs/SharedPreferences p "recent_searches" (vec recents)))))
  nil)

(defn- remember-search! [query]
  (let [recents (:recent-searches @app-state)
        updated (into [query] (remove #(= % query)) recents)
        updated (into [] (take max-recent-searches) updated)]
    (swap! app-state assoc :recent-searches updated)
    (persist-recents! updated)))

;; --- Settings ---

(defn load-settings! []
  (let [p (await (prefs.SharedPreferences/getInstance))
        is-dark (or (.getBool p "isDark") false)
        enabled-sources (.getStringList p "enabled_sources")
        share-min (or (.getBool p "is_share_minimal") false)
        show-yt (let [v (.getBool p "show_youtube_button")]
                  (if (nil? v) true v))
        recents (or (.getStringList p "recent_searches") [])
        favorites (or (.getStringList p "favorites") [])]
    (swap! app-state assoc
           :theme-mode (if is-dark mat.ThemeMode/dark mat.ThemeMode/light)
           :enabled-sources (if (and enabled-sources (not (empty? enabled-sources)))
                              (set (seq enabled-sources))
                              all-sources)
           :is-share-minimal share-min
           :show-youtube-button show-yt
           :recent-searches (vec recents)
           :favorites (into [] (keep json->item) favorites)
           :active-filters #{"Ambos"})))

(defn toggle-theme! []
  (let [new-mode (if (= (:theme-mode @app-state) mat.ThemeMode/light) mat.ThemeMode/dark mat.ThemeMode/light)]
    (swap! app-state assoc :theme-mode new-mode)
    (-> (prefs.SharedPreferences/getInstance)
        (.then (fn [p]
                 (.setBool ^prefs/SharedPreferences p "isDark" (= new-mode mat.ThemeMode/dark)))))
    nil))

(defn set-share-minimal! [val]
  (swap! app-state assoc :is-share-minimal val)
  (-> (prefs.SharedPreferences/getInstance)
      (.then (fn [p]
               (.setBool ^prefs/SharedPreferences p "is_share_minimal" val))))
  nil)

(defn set-show-youtube-button! [val]
  (swap! app-state assoc :show-youtube-button val)
  (-> (prefs.SharedPreferences/getInstance)
      (.then (fn [p]
               (.setBool ^prefs/SharedPreferences p "show_youtube_button" val))))
  nil)

(defn set-source-enabled! [source val]
  (let [new-sources (if val
                      (conj (:enabled-sources @app-state) source)
                      (disj (:enabled-sources @app-state) source))]
    (swap! app-state assoc :enabled-sources new-sources)
    (-> (prefs.SharedPreferences/getInstance)
        (.then (fn [p]
                 (.setStringList ^prefs/SharedPreferences p "enabled_sources" (vec new-sources)))))
    nil))

;; --- Search ---

(defn perform-search! [query]
  (when-not (str/blank? query)
    (let [token (:search-token (swap! app-state update :search-token inc))]
      (swap! app-state assoc
             :is-loading true :search-results [] :failed-sources []
             :error-message nil :last-searched query)
      (remember-search! query)
      (try
        (api/log "=== START DICTIONARY SEARCH ===" query)
        (let [enabled (:enabled-sources @app-state)
              {:keys [items failed]} (await (api/search-all query :sources (seq enabled)))]
          ;; Drop stale responses: only the latest search may write results.
          (when (= token (:search-token @app-state))
            (api/log "=== DICTIONARY SEARCH RESULTS ===" (count items) "failed:" failed)
            (swap! app-state assoc
                   :search-results (vec items)
                   :failed-sources (vec failed)
                   :is-loading false)))
        (catch Object e
          (api/log "Error performing search:" e)
          (when (= token (:search-token @app-state))
            (swap! app-state assoc :is-loading false :error-message s/search-error)))))))

(defn preload-ines!
  "Warms the INES word list (autocomplete + offline cache). Failures
  are logged, never surfaced — the list loads again on first search."
  []
  (try
    (await (api/load-ines-data))
    (api/log "INES preload OK:" (count (api/ines-words)) "words")
    (catch Object e
      (api/log "INES preload failed:" e))))

(defn suggestions-for
  "Autocomplete suggestions from the INES word list: prefix matches
  first, then substring matches, capped at `limit`."
  [query limit]
  (if (< (count query) 2)
    []
    (let [nq (api/normalize query)
          words (api/ines-words)
          scored (into []
                       (keep (fn [^String w]
                               (let [nw ^String (api/normalize w)]
                                 (cond
                                   (= nw nq) nil ; already typed exactly
                                   (.startsWith nw nq) [0 w]
                                   (.contains nw nq) [1 w]
                                   :else nil))))
                       words)]
      (into []
            (comp (map second) (distinct) (take limit))
            (sort scored)))))

(defn rank-results
  "Exact title matches first, then title-prefix matches, then the rest;
  alphabetical within each band."
  [results query]
  (let [nq (api/normalize query)]
    (vec
     (sort-by (fn [item]
                (let [nt (api/normalize (or (:title item) ""))]
                  [(cond
                     (= nt nq) 0
                     (.startsWith ^String nt nq) 1
                     :else 2)
                   nt]))
              results))))

(defn on-filter-changed! [filter-name selected]
  (swap! app-state
         (fn [state]
           (let [enabled (:enabled-sources state)
                 current (:active-filters state #{"Ambos"})
                 next-filters (if (= filter-name "Ambos")
                                #{"Ambos"}
                                (let [updated (if selected
                                                (conj (disj current "Ambos") filter-name)
                                                (disj current filter-name))]
                                  (if (or (empty? updated)
                                          (every? #(contains? updated %) enabled))
                                    #{"Ambos"}
                                    updated)))]
             (assoc state :active-filters next-filters)))))

;; --- Share / external links ---

(def ^services/MethodChannel share-channel (services/MethodChannel. "dev.edbn.libras_dictionary/share"))

(defn share! [text subject]
  (try
    (await (.invokeMethod share-channel "share" {"text" text "subject" subject}))
    (catch services/PlatformException e
      (api/log "Failed to share:" (.-message ^services/PlatformException e)))))

(defn share-item! [item]
  (let [share-text (if (:is-share-minimal @app-state)
                     (s/share-text-minimal (:title item) (:link item))
                     (s/share-text-full (:title item) (:link item)))]
    (share! share-text (s/share-subject (:title item)))
    nil))

(defn launch-url! [url-str]
  (let [uri (Uri/parse url-str)]
    (when (await (url-l/launchUrl uri))
      nil)))

(defn open-youtube-search!
  "Opens a YouTube search for the query in the YouTube app/browser.
  In-app YouTube search was removed for YouTube ToS compliance."
  [query]
  (when-not (str/blank? query)
    (launch-url! (api/youtube-search-url query))))
