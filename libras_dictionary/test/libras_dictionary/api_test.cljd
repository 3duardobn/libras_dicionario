(ns libras-dictionary.api-test
  (:require [clojure.test :refer [deftest is testing]]
            [libras-dictionary.api :as api]
            [libras-dictionary.state :as st]
            [libras-dictionary.models :as m]))

(deftest normalize-test
  (testing "lowercases and strips diacritics"
    (is (= "acao" (api/normalize "Ação")))
    (is (= "video" (api/normalize "VÍDEO")))
    (is (= "ja" (api/normalize "já")))))

(deftest word-bound-regex-test
  (let [^RegExp r (api/word-bound-regex "casa")]
    (testing "matches the whole word"
      (is (.hasMatch r "casa"))
      (is (.hasMatch r "minha casa nova")))
    (testing "does not match inside another word"
      (is (not (.hasMatch r "casarao")))
      (is (not (.hasMatch r "carcasa"))))
    (testing "query is normalized"
      (is (.hasMatch ^RegExp (api/word-bound-regex "Ação") "acao urgente")))))

(deftest extract-video-and-youtube-id-test
  (testing "video tag wins"
    (let [r (api/extract-video-and-youtube-id
             "<p>x</p><video controls src=\"https://ex.com/sinal.mp4\"></video>")]
      (is (= "https://ex.com/sinal.mp4" (:video-url r)))
      (is (nil? (:youtube-id r)))))

  (testing "youtube embed iframe"
    (let [r (api/extract-video-and-youtube-id
             "<iframe src=\"https://www.youtube.com/embed/abc123XYZ?feature=oembed\"></iframe>")]
      (is (nil? (:video-url r)))
      (is (= "abc123XYZ" (:youtube-id r)))))

  (testing "youtube watch url"
    (let [r (api/extract-video-and-youtube-id
             "veja https://www.youtube.com/watch?v=qwe456 no site")]
      (is (= "qwe456" (:youtube-id r)))))

  (testing "youtu.be short url"
    (let [r (api/extract-video-and-youtube-id
             "<a href=\"https://youtu.be/short789\">video</a>")]
      (is (= "short789" (:youtube-id r)))))

  (testing "bare mp4 src fallback"
    (let [r (api/extract-video-and-youtube-id
             "<source src=\"http://ex.com/media/palavra.mp4\" type=\"video/mp4\">")]
      (is (= "http://ex.com/media/palavra.mp4" (:video-url r)))))

  (testing "video tag has precedence over youtube"
    (let [r (api/extract-video-and-youtube-id
             (str "<video src=\"https://ex.com/a.mp4\"></video>"
                  "<iframe src=\"https://www.youtube.com/embed/zzz\"></iframe>"))]
      (is (= "https://ex.com/a.mp4" (:video-url r)))
      (is (nil? (:youtube-id r)))))

  (testing "nothing found"
    (let [r (api/extract-video-and-youtube-id "<p>apenas texto</p>")]
      (is (nil? (:video-url r)))
      (is (nil? (:youtube-id r))))))

(deftest youtube-search-url-test
  (let [url (api/youtube-search-url "bom dia")]
    (is (.startsWith ^String url "https://www.youtube.com/results?search_query="))
    (is (.contains ^String url "em+libras"))
    (is (.contains ^String url "bom+dia"))))

(deftest parse-ines-body-test
  (testing "extracts the JSON array from the JS wrapper"
    (let [body "var palavras = [{\"palavra\": \"CASA\", \"video\": \"casa.mp4\"}];"
          data (api/parse-ines-body body)]
      (is (= 1 (count data)))
      (is (= "CASA" (get (first data) "palavra")))))
  (testing "returns nil for garbage"
    (is (nil? (api/parse-ines-body "not js at all")))))

(deftest ines-words-test
  (reset! api/ines-cache [{"palavra" "CASA"} {"palavra" "CACHORRO"} {"outro" 1}])
  (is (= ["CASA" "CACHORRO"] (api/ines-words)))
  (reset! api/ines-cache nil)
  (is (= [] (api/ines-words))))

(deftest suggestions-for-test
  (reset! api/ines-cache [{"palavra" "CASA"} {"palavra" "CASACO"} {"palavra" "MACACO"} {"palavra" "BOLA"}])
  (testing "prefix matches come before substring matches"
    (is (= ["CASA" "CASACO"] (st/suggestions-for "cas" 6))))
  (testing "substring matches included"
    (is (= ["MACACO"] (st/suggestions-for "aca" 6))))
  (testing "short queries yield nothing"
    (is (= [] (st/suggestions-for "c" 6))))
  (testing "limit respected"
    (is (= 1 (count (st/suggestions-for "cas" 1)))))
  (reset! api/ines-cache nil))

(deftest rank-results-test
  (let [mk (fn [t] (m/make-dict-item :title t :source "INES"))
        results [(mk "Casamento") (mk "Zebra casa") (mk "Casa")]
        ranked (st/rank-results results "casa")]
    (testing "exact title first, then prefix, then rest"
      (is (= ["Casa" "Casamento" "Zebra casa"] (mapv :title ranked))))))
