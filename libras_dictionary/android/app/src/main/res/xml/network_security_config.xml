<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- UFF and INES serve sign videos over plain HTTP; everything else is HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">librasacademica.uff.br</domain>
        <domain includeSubdomains="false">dicionario.ines.gov.br</domain>
    </domain-config>
</network-security-config>
